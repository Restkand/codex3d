---
/**
 * Kartu tautan di dalam konten MDX. Link internal (diawali "/") otomatis diberi base path,
 * agar tetap benar saat situs di-deploy ke sub-path.
 *   import LinkCard from '~/components/LinkCard.astro'
 *   <LinkCard title="Kamus" href="/kamus/" description="..." />
 */
import { withBase } from '../lib/inline.js'

interface Props {
  title: string
  href: string
  description?: string
}
const { title, href, description } = Astro.props
const resolved = href.startsWith('/') && !href.startsWith('//') ? withBase(href) : href
---

<a class="link-card" href={resolved}>
  <strong class="link-card__title">{title}</strong>
  {description && <span class="link-card__desc">{description}</span>}
  <span class="link-card__arrow" aria-hidden="true">→</span>
</a>

<style>
  .link-card {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 44px 16px 18px;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .link-card:hover {
    border-color: var(--accent);
  }

  .link-card__title {
    color: var(--sl-color-white);
  }

  .link-card__desc {
    font-size: 15px;
    color: var(--sl-color-gray-3);
  }

  .link-card__arrow {
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    color: var(--accent);
  }
</style>

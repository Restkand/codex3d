---
/**
 * Layout bersama semua halaman konten: pelajaran, Kamus, dan halaman umum situs.
 * Berisi: bilah atas, kolom navigasi kiri (slot "side"), isi utama, dan Krekit pendamping.
 *
 * Props:
 *   title, description : untuk <title> dan meta
 *   crumbs             : jejak posisi [{ label, href? }]
 *   greeting           : kalimat sapaan Krekit saat halaman dibuka (opsional)
 *   readingProgress    : tampilkan bilah progres membaca (untuk halaman panjang seperti pelajaran)
 *   krekitLines        : kalimat Krekit per bagian { idJudul: kalimat } (dari frontmatter `krekit`)
 *   lessonId           : id pelajaran, agar Krekit tahu jika pelajaran ini sudah diselesaikan
 */
import '../styles/theme.css'
import '../site/lesson.css'
import { SITE } from '../site.config.mjs'
import SocialMeta from '../components/SocialMeta.astro'
import Analytics from '../components/Analytics.astro'
import { withBase } from '../lib/inline.js'
import BottomNav from '../components/BottomNav.astro'

interface Crumb {
  label: string
  href?: string
}
interface Props {
  title: string
  description?: string
  crumbs?: Crumb[]
  greeting?: string
  readingProgress?: boolean
  krekitLines?: Record<string, string>
  lessonId?: string
  /** Path file sumber relatif ke root repo (entry.filePath), untuk tautan "Edit halaman ini" */
  editPath?: string
}
const { title, description = SITE.tagline, crumbs = [], greeting, readingProgress = false, krekitLines = {}, lessonId, editPath } = Astro.props
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} · {SITE.name}</title>
    <meta name="description" content={description} />
    <SocialMeta title={`${title} · ${SITE.name}`} description={description} type={lessonId ? 'article' : 'website'} />
    <Analytics />
  </head>
  <body class="lesson-page">
    <!-- Elemen pertama yang bisa difokus: pengguna keyboard langsung melompati bilah atas dan navigasi kiri -->
    <a class="skip-link" href="#isi">Langsung ke isi</a>
    <header class="lbar">
      <a class="lbar__brand" href={withBase('/')}>
        <img src={withBase('/favicon.svg')} alt="" width="22" height="22" />
        <span>{SITE.name}</span>
      </a>
      {
        crumbs.length > 0 && (
          <nav class="lbar__crumbs" aria-label="Posisi">
            {crumbs.map((crumb, i) => (
              <>
                {i > 0 && <span aria-hidden="true">/</span>}
                {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <nav class="lbar__nav" aria-label="Utama">
        <a href={withBase('/belajar/')}>Belajar</a>
        <a href={withBase('/kamus/')}>Kamus</a>
        <a href={withBase('/lab/')}>Lab</a>
        <a href={SITE.repo}>GitHub</a>
      </nav>
      {readingProgress && <div class="lbar__progress" aria-hidden="true"><div data-read-progress /></div>}
    </header>

    <div class="lgrid">
      <aside class="lside" aria-label="Navigasi">
        <slot name="side" />
      </aside>
      <main class="lmain" id="isi" tabindex="-1">
        <slot />
        {
          editPath && (
            <p class="ledit">
              Menemukan kesalahan? <a href={`${SITE.repo}/edit/main/${editPath}`}>Edit halaman ini di GitHub</a>
              <br />
              Konten <a href={withBase('/lisensi/')}>CC BY-NC-SA 4.0</a>, potongan kode MIT.
            </p>
          )
        }
      </main>
    </div>

    <!-- Krekit sebagai pendamping (src/site/lesson.js). Model 3D-nya dimuat belakangan, setelah halaman senggang. -->
    <div class="companion" data-companion data-greeting={greeting} data-lines={JSON.stringify(krekitLines)} data-lesson-id={lessonId} hidden>
      <!-- Teks yang diketik per huruf hanya untuk mata; pembaca layar mendapat kalimat lengkap dari status di bawah -->
      <div class="companion__bubble" data-companion-bubble aria-hidden="true"></div>
      <canvas class="companion__canvas" aria-label="Krekit, pendamping belajar" role="img"></canvas>
      <button type="button" class="companion__toggle" data-companion-toggle aria-label="Sembunyikan Krekit">–</button>
    </div>
    <button type="button" class="companion-restore" data-companion-restore hidden>Panggil Krekit</button>
    <!-- Di luar .companion agar live region sudah ada (tidak hidden) sebelum Krekit pertama kali bicara -->
    <p class="sr-only" role="status" data-companion-status></p>

    <script>
      import '../site/lesson.js'
    </script>
    <BottomNav />
  </body>
</html>

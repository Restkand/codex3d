---
/**
 * Halaman depan bersama Krekit, maskot 3D (lihat src/site/landing.js dan src/site/krekit.js).
 *
 * Setiap section punya "panggung" [data-krekit-spot]: kotak kosong di layout tempat Krekit berdiri.
 * Krekit tidak pernah menutupi teks karena tempatnya disediakan oleh layout itu sendiri.
 * Elemen dengan [data-krekit-say] membuat Krekit menoleh dan berkomentar saat disorot.
 */
import { getCollection } from 'astro:content'
import '../site/landing.css'
// Font judul Pos 0, dipasang dari npm (tanpa permintaan ke Google Fonts). Hanya dimuat di beranda.
import '@fontsource-variable/bricolage-grotesque/opsz.css'
import { SITE } from '../site.config.mjs'
import { TRACKS, KAMUS_CHAPTERS } from '../lib/sections.js'
import { withBase } from '../lib/inline.js'
import BottomNav from '../components/BottomNav.astro'
import SocialMeta from '../components/SocialMeta.astro'
import ShareButton from '../components/ShareButton.astro'
import { LEVELS, LESSON_XP } from '../lib/progress.js'

const docs = await getCollection('docs')
const termCount = docs.filter((d) => d.data.kind === 'term').length
const lessonsIn = (trackId) => docs.filter((d) => d.data.kind === 'lesson' && d.id.startsWith(`belajar/${trackId}/`)).length
const trackStatus = (id) => docs.find((d) => d.id === `belajar/${id}`)?.data.status
const pad2 = (n) => String(n).padStart(2, '0')

// Pos 5 · Layar akhir: daftar kredit. Angka dihitung dari isi situs saat build
const lessonCount = docs.filter((d) => d.data.kind === 'lesson').length
const CREDITS = [
  { role: 'Dibuat oleh', name: 'Restkand', note: 'mengarahkan materi dan memeriksa isinya' },
  { role: 'Maskot', name: 'Krekit', note: 'dibangun dari geometri Three.js' },
  { role: 'Isi', name: `${lessonCount} pelajaran · ${termCount} istilah Kamus` },
  { role: 'Dibangun dengan', name: 'Astro · Three.js · GSAP' },
  { role: 'Huruf judul', name: 'Bricolage Grotesque' },
  { role: 'Kontributor', slot: true },
  { role: 'Lisensi', name: 'Konten CC BY-NC-SA 4.0 · Kode MIT' },
]

// Pos 4 · Chat tanya-jawab: keraguan pembaca dan aturan konten yang menjawabnya (lihat Standar konten)
const RULES_QA = [
  {
    id: 'bersumber',
    title: 'Bersumber',
    question: 'Angka di artikel ini dari mana?',
    answer: 'Setiap angka, kebijakan platform, dan ketentuan lisensi wajib menautkan sumbernya beserta tanggal akses, supaya kamu bisa mengeceknya sendiri.',
  },
  {
    id: 'ditinjau',
    title: 'Ditinjau',
    question: 'Sudah dicek orang yang paham?',
    answer: 'Setiap halaman menulis statusnya di bagian atas: kerangka, draf, atau ditinjau praktisi. Dari situ kamu tahu seberapa jauh isinya sudah diperiksa.',
  },
  {
    id: 'netral',
    title: 'Netral',
    question: 'Ini iklan, bukan?',
    answer: 'Kerja sama dengan mitra selalu diungkap di halaman, dan kerja sama itu tidak mengubah penilaian di konten edukasi.',
  },
]

// Pos 3 · Tarik kartu istilah: semua istilah Kamus sebagai tumpukan kartu (dikocok di browser, landing.js)
const DECK = docs
  .filter((d) => d.data.kind === 'term')
  .map((d) => ({
    title: d.data.title,
    aka: d.data.aka ?? '',
    description: d.data.description ?? '',
    chapter: KAMUS_CHAPTERS.find((c) => c.id === d.id.split('/')[1])?.title ?? '',
    level: d.data.level ?? 1,
    levelName: LEVELS[d.data.level ?? 1].name,
    status: d.data.status ?? 'draf',
    href: withBase(`/${d.id}/`),
  }))
const firstCard = DECK.find((t) => t.title === 'Frame') ?? DECK[0]

// Pos 2 · Pohon skill: induk tiap jalur, posisi tengah node (% lebar pohon), baris, dan nama cabang.
// Cabang hanya saran urutan belajar, bukan prasyarat.
const SKILL_TREE = {
  'fondasi-engine': { x: 50, row: 0 },
  'lanskap-engine': { parent: 'fondasi-engine', x: 16, row: 1, branch: 'teknis' },
  'desain-game': { parent: 'fondasi-engine', x: 50, row: 1, branch: 'kreatif' },
  produksi: { parent: 'fondasi-engine', x: 84, row: 1, branch: 'tim & studio' },
  'bisnis-indie': { parent: 'produksi', x: 60, row: 2 },
  'industri-karier': { parent: 'produksi', x: 87, row: 2 },
  'seni-visual': { parent: 'desain-game', x: 26, row: 2 },
}

// Pos 1 · Jalur produksi: stasiun yang dilewati sebuah game, dari engine sampai ke pemain
const STATIONS = [
  { id: 'engine', label: 'Engine', tone: '#5cc1a8', caption: 'Engine menggambar dunia game, frame demi frame.' },
  { id: 'desain', label: 'Desain', tone: '#6fb3e8', caption: 'Desain menentukan bentuk, warna, dan aturan main.' },
  { id: 'produksi', label: 'Produksi', tone: '#8b7ae6', caption: 'Tim produksi membangun, menguji, lalu mengemas game.' },
  { id: 'bisnis', label: 'Bisnis', tone: '#f2b84b', caption: 'Game didanai, dipasarkan, lalu dijual.' },
  { id: 'pemain', label: 'Pemain', tone: '#ff8fc8', caption: 'Akhirnya game sampai di tangan pemain.' },
]

// Daftar halaman ber-XP, agar Krekit bisa membaca tahap pertumbuhan dari progres di browser
const progressItems = docs
  .filter((d) => d.data.kind === 'lesson' || d.data.kind === 'term')
  .map((d) => ({ id: d.id, xp: d.data.kind === 'lesson' ? LESSON_XP : LEVELS[d.data.level ?? 1].xp }))
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{SITE.name} · Belajar cara game dibuat</title>
    <!-- Judul hero ("Lewat celah ini...") butuh visual; pratinjau tautan memakai kalimat yang lugas -->
    <meta name="description" content="Pahami fundamental di balik sebuah game: engine dan shader, desain, produksi, sampai bisnis studio indie." />
    <SocialMeta
      title={`${SITE.name} · Belajar cara game dibuat`}
      description="Pahami fundamental di balik sebuah game: engine dan shader, desain, produksi, sampai bisnis studio indie."
    />
    <!--
      Kelas "js" membuat teks transparan (opacity, bukan visibility) sampai animasi masuk siap (mencegah kedipan).
      Pengaman: jika landing.js belum berjalan dalam 4 detik (jaringan lambat, chunk gagal dimuat), kelas dilepas
      agar teks tetap terlihat. landing.js menandai dirinya dengan kelas "js-ready".
    -->
    <script is:inline>
      document.documentElement.classList.add('js')
      setTimeout(() => document.documentElement.classList.contains('js-ready') || document.documentElement.classList.remove('js'), 4000)
    </script>
  </head>
  <body>
    <a class="skip-link" href="#konten">Langsung ke isi</a>
    <canvas class="webgl" aria-hidden="true"></canvas>
    <script type="application/json" id="progress-items" set:html={JSON.stringify(progressItems)} />

    <header class="topnav" data-topnav>
      <a class="topnav__brand" href={withBase('/')}>
        <img src={withBase('/favicon.svg')} alt="" width="24" height="24" />
        <span>{SITE.name}</span>
      </a>
      <nav class="topnav__links" aria-label="Utama">
        <a href={withBase('/belajar/')}>Belajar</a>
        <a href={withBase('/kamus/')}>Kamus</a>
        <a href={withBase('/lab/')} class="hide-sm">Lab</a>
        <a href={SITE.repo} class="topnav__gh">GitHub</a>
      </nav>
    </header>

    <!-- Penanda di tepi jalan Pos 0: muncul saat Krekit lewat. data-waypoint = posisi di jalan (0..1) -->
    <div class="waypoints" aria-hidden="true">
      <span class="waypoint" data-waypoint="0.3">Engine &amp; shader</span>
      <span class="waypoint" data-waypoint="0.5">Desain</span>
      <span class="waypoint" data-waypoint="0.7">Produksi</span>
      <span class="waypoint" data-waypoint="0.9">Bisnis studio indie</span>
    </div>

    <!--
      Gelembung bicara Krekit: posisinya mengikuti kepala Krekit (landing.js). Teksnya diketik per huruf,
      jadi disembunyikan dari pembaca layar; kalimat lengkapnya diumumkan sekali lewat [data-bubble-say].
    -->
    <div class="bubble" data-bubble aria-hidden="true">
      <div class="bubble__box" data-bubble-box></div>
    </div>
    <p class="sr-only" role="status" data-bubble-say></p>

    <main id="konten" tabindex="-1">
      <!-- Pos 0 · Dunia belum di-render (landing.js + dunia.js). Desktop: hero di-pin, Krekit menggelinding. Layar sempit: diorama, ketuk untuk me-render -->
      <section id="mulai" class="section section--split hero" data-section>
        <div class="hero__text">
          <!-- tabindex="-1": tujuan fokus tombol "Main lagi" di Pos 5 (landing.js), tidak masuk urutan Tab -->
          <h1 class="display display--hero" aria-label="Lewat celah ini, kelihatan cara game dibuat." data-hero-title tabindex="-1">Lewat celah ini, <span class="accent" data-hero-wire>kelihatan cara game dibuat.</span></h1>
          <p class="lead">Pelajari apa yang ada di balik sebuah game: engine dan shader, desain, produksi, sampai bisnis studio indie.</p>
          <div class="actions">
            <a class="btn btn--primary" href={withBase('/belajar/')} data-krekit-say="Pelajaran 1 tidak butuh pengetahuan 3D sebelumnya."><span class="btn__label">Mulai belajar →</span></a>
            <a class="btn btn--ghost" href={withBase('/lab/')} data-krekit-say="Di Lab kamu bisa membedah aku: lihat segitigaku, ganti shading, dan atur auraku."><span class="btn__label">Buka Lab</span></a>
          </div>
          <!-- Satu teks di HTML; versi layar sentuh dipasang landing.js agar tidak terbaca ganda -->
          <p class="scroll-hint" data-touch-text="Geser ke atas untuk mengikuti Krekit · ketuk Krekit">Scroll untuk mengikuti Krekit · klik Krekit</p>
        </div>
        <div class="krekit-spot krekit-spot--hero" data-krekit-spot>
          <!-- Layar sempit: tahap render diorama Krekit (landing.js). Disembunyikan di layar lebar. -->
          <div class="render-steps" role="group" aria-label="Tahap render dunia Krekit">
            <button type="button" data-render-step="0" aria-pressed="true">Wireframe</button>
            <button type="button" data-render-step="1" aria-pressed="false">Blockout</button>
            <button type="button" data-render-step="2" aria-pressed="false">Render</button>
          </div>
        </div>
      </section>

      <!-- 01 · Kenapa -->
      <section id="kenapa" class="section section--split section--flip section--belt reveal" data-section>
        <!--
          Pos 1 · Jalur produksi: ban berjalan membawa "game" melewati setiap stasiun (landing.js).
          Desktop: section di-pin, scroll menggerakkan ban, Krekit 3D menumpang di tengahnya.
          HP: ban digeser dengan jari, telur Krekit 2D di tengah ban yang berubah di tiap stasiun.
        -->
        <div class="krekit-spot krekit-spot--scene" data-krekit-spot>
          <div class="belt" data-belt data-stage={STATIONS[0].id}>
            <div class="belt__track" data-belt-track>
              <ol class="belt__row">
                {STATIONS.map((station, i) => (
                  <li class="belt__station" data-station={station.id} data-caption={station.caption} style={`--tone: ${station.tone}`}>
                    <button type="button" class="belt__gate" data-station-go={i} aria-label={`${pad2(i + 1)} ${station.label}: ${station.caption}`}>
                      <span class="belt__label">{pad2(i + 1)} {station.label}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </div>
            <!-- Barang di atas ban. Desktop: Krekit 3D berdiri di sini, jadi hanya kotak & label yang tampil -->
            <div class="belt__item" aria-hidden="true">
              <svg class="belt__egg" viewBox="0 0 80 100">
                <defs>
                  <clipPath id="belt-egg-shape"><path d="M40 2C63 2 78 38 78 62C78 84 61 98 40 98C19 98 2 84 2 62C2 38 17 2 40 2Z" /></clipPath>
                </defs>
                <path class="belt__egg-shell" d="M40 2C63 2 78 38 78 62C78 84 61 98 40 98C19 98 2 84 2 62C2 38 17 2 40 2Z" />
                <path class="belt__egg-crack" clip-path="url(#belt-egg-shape)" d="M0 44L9 37L17 45L26 36L34 44L43 35L51 44L60 36L68 45L80 38V64L71 58L62 66L53 57L44 65L35 57L26 66L17 58L8 65L0 59Z" />
                <rect class="belt__egg-eye" x="26" y="45" width="9" height="12" rx="4.5" />
                <rect class="belt__egg-eye" x="45" y="45" width="9" height="12" rx="4.5" />
              </svg>
              <span class="belt__box"><span>KREKIT</span></span>
              <span class="belt__tag">RILIS</span>
            </div>
          </div>
          <p class="belt__caption" data-belt-caption aria-live="polite">
            <b data-belt-step>01 / 05</b> <span data-belt-text>{STATIONS[0].caption}</span>
          </p>
        </div>
        <div class="section__inner">
          <p class="eyebrow" data-reveal>01 · Kenapa situs ini ada</p>
          <h2 class="display display--md" data-reveal>Bisa berjalan<br /><span class="accent">belum tentu hidup.</span></h2>
          <p class="lead" data-reveal>Sekarang prototipe game bisa jadi dalam hitungan jam. Tapi kenapa sebuah lompatan terasa enak, atau kenapa game patah-patah di HP tertentu, hanya bisa dijawab kalau kamu paham dasarnya. Di sini kamu mempelajari dasar itu, dari cara engine menggambar satu frame sampai cara game diproduksi, didanai, dan sampai ke pemain.</p>
          <!-- Ajakan yang bisa langsung ditanggapi: mulai dari pelajaran pertama -->
          <div class="start" data-reveal>
            <a class="btn btn--primary btn--wire" href={withBase('/belajar/fondasi-engine/01-frame/')} data-krekit-say="Pelajaran 1 tidak butuh pengetahuan 3D sebelumnya."><span class="btn__label">Mulai dari Pelajaran 1 →</span></a>
            <p class="start__note">Setiap pelajaran punya demo yang bisa dicoba dan kuis singkat.</p>
          </div>
        </div>
      </section>

      <!--
        02 · Jalur belajar sebagai pohon skill (landing.js): akar Fondasi Engine di atas, cabang di bawahnya.
        Menyorot (desktop) atau mengetuk (HP) sebuah node: cabang dari akar menyala, panel menampilkan ringkasannya,
        dan Krekit pindah ke atas node itu (desktop) atau berkomentar dari pojok (HP).
      -->
      <section id="jalur" class="section section--tree reveal" data-section>
        <div class="tree-head">
          <p class="eyebrow" data-reveal>02 · Jalur belajar</p>
          <h2 class="display display--md" data-reveal>Tujuh jalur belajar, <span class="accent">mulai dari Fondasi Engine.</span></h2>
          <p class="lead" data-reveal>Mulai dari akarnya, lalu pilih cabang sesuai peran yang kamu minati. Urutan cabang hanya saran, jadi kamu boleh melompat.</p>
        </div>
        <div class="skill-tree" data-skill-tree data-reveal>
          <div class="krekit-spot krekit-spot--tree" data-krekit-spot aria-hidden="true"></div>
          <svg class="skill-tree__edges" aria-hidden="true"></svg>
          {
            TRACKS.map((track, i) => {
              const place = SKILL_TREE[track.id]
              const live = trackStatus(track.id) !== 'kerangka'
              return (
                <a
                  class:list={['skill', live ? 'is-live' : 'is-locked', i === 0 && 'is-selected']}
                  href={withBase(`/belajar/${track.id}/`)}
                  style={`--x: ${place.x}%; --r: ${place.row}`}
                  data-skill={track.id}
                  data-parent={place.parent}
                  data-num={pad2(i + 1)}
                  data-title={track.title}
                  data-blurb={track.blurb}
                  data-status={live ? `${lessonsIn(track.id)} pelajaran tersedia` : 'Kerangka · butuh kontributor'}
                  data-krekit-line={track.krekit}
                >
                  {place.branch && <span class="skill__branch">{place.branch}</span>}
                  <span class="skill__num">{pad2(i + 1)}</span>
                  <strong class="skill__title">{track.title}</strong>
                  <span class="skill__state" aria-hidden="true">{live ? '✦' : ''}</span>
                </a>
              )
            })
          }
        </div>
        <div class="skill-panel" data-skill-panel aria-live="polite" data-reveal>
          <div class="skill-panel__top">
            <p class="skill-panel__meta"><b data-panel-num>01</b> <span data-panel-status>{lessonsIn(TRACKS[0].id)} pelajaran tersedia</span></p>
            <!-- Berpindah jalur tanpa menyentuh pohon; di HP pilihan tidak berubah sendiri saat halaman di-scroll -->
            <div class="skill-panel__nav">
              <button type="button" data-skill-step="-1" aria-label="Jalur sebelumnya">‹</button>
              <span data-panel-count>1 / {TRACKS.length}</span>
              <button type="button" data-skill-step="1" aria-label="Jalur berikutnya">›</button>
            </div>
          </div>
          <h3 class="skill-panel__title" data-panel-title>{TRACKS[0].title}</h3>
          <p class="skill-panel__blurb" data-panel-blurb>{TRACKS[0].blurb}</p>
          <a class="btn btn--ghost btn--wire skill-panel__go" data-panel-link href={withBase(`/belajar/${TRACKS[0].id}/`)}><span class="btn__label">Buka jalur →</span></a>
        </div>
      </section>

      <!-- 03 · Kamus -->
      <section id="kamus" class="section section--split section--draw reveal" data-section>
        <div class="section__inner">
          <p class="eyebrow" data-reveal>03 · Kamus</p>
          <h2 class="display display--md" data-reveal><span data-count={termCount}>{termCount}</span> istilah,<br /><span class="accent">tarik satu kartu.</span></h2>
          <p class="lead" data-reveal>Setiap kartu berisi satu istilah teknis dengan penjelasan singkat. Di Kamus, setiap istilah punya analogi, demo, dan tautan ke istilah lain yang berkaitan.</p>
          <div class="actions" data-reveal>
            <a class="btn btn--ghost btn--wire" href={withBase('/kamus/')} data-krekit-say="Di halaman Kamus ada pencarian. Ketik saja istilah yang membuatmu bingung."><span class="btn__label">Buka Kamus →</span></a>
          </div>
        </div>
        <!--
          Pos 3 · Tarik kartu istilah (landing.js): tumpukan dikocok di browser, kartu terbang dari tumpukan
          lalu terbalik. Desktop: Krekit berdiri di atas tumpukan. HP: Krekit berkomentar dari pojok.
        -->
        <div class="draw" data-draw data-reveal>
          <div class="draw__deck">
            <div class="krekit-spot krekit-spot--deck" data-krekit-spot aria-hidden="true"></div>
            <div class="draw__stack" data-draw-stack aria-hidden="true"><span>KREKIT</span></div>
            <button type="button" class="btn btn--primary btn--wire draw__btn" data-draw-btn><span class="btn__label">Tarik kartu</span></button>
            <p class="draw__count" data-draw-count>{DECK.length} kartu di tumpukan</p>
          </div>
          <div class="draw__slot">
            <div class="term-card" data-card>
              <div class="term-card__inner" data-card-inner>
                <article class="term-card__face term-card__front" aria-live="polite">
                  <p class="term-card__top">
                    <span data-card-chapter>{firstCard.chapter}</span>
                    <span class="term-card__level" data-card-level={firstCard.level} title="Level">
                      <i></i><i></i><i></i> <span data-card-level-name>{firstCard.levelName}</span>
                    </span>
                  </p>
                  <h3 class="term-card__title" data-card-title>{firstCard.title}</h3>
                  <p class="term-card__aka" data-card-aka>{firstCard.aka}</p>
                  <p class="term-card__desc" data-card-desc>{firstCard.description}</p>
                  <a class="term-card__link" data-card-link href={firstCard.href}>Baca di Kamus →</a>
                </article>
                <div class="term-card__face term-card__back" aria-hidden="true"><span>KREKIT</span><small>Kamus</small></div>
              </div>
            </div>
          </div>
        </div>
        <script type="application/json" id="kamus-deck" set:html={JSON.stringify(DECK)} />
      </section>

      <!-- 04 · Prinsip -->
      <section id="prinsip" class="section section--split section--flip section--chat reveal" data-section>
        <!--
          Pos 4 · Chat tanya-jawab (landing.js): tiga keraguan yang wajar dirasakan pembaca, dijawab Krekit
          dengan aturan konten beserta contoh wujudnya di halaman. Pertanyaan dipilih lewat tombol balasan cepat.
          Tanpa JavaScript seluruh percakapan tampil. Desktop: Krekit 3D berdiri di samping jendela chat.
        -->
        <figure class="chat" data-chat data-reveal>
          <div class="chat__window">
            <div class="chat__bar"><img src={withBase('/favicon.svg')} alt="" width="26" height="26" /><b>Krekit</b><span>● daring</span></div>
            <div class="chat__log" data-chat-log aria-live="polite">
              <div class="msg msg--krekit">Ada yang membuatmu ragu saat membaca konten game? Pilih pertanyaanmu di bawah.</div>
              {RULES_QA.map((rule, i) => (
                <>
                  <div class="msg msg--you" data-chat-q={rule.id}>{rule.question}</div>
                  <div class="msg msg--krekit" data-chat-a={rule.id}>
                    <span class="msg__rule">Aturan {i + 1} · {rule.title}</span>
                    <p>{rule.answer}</p>
                    <div class="msg__example">
                      <small>Contoh di halaman</small>
                      {rule.id === 'bersumber' && <span>¹ Sumber: dokumen resmi platform · diakses 28 Okt 2026</span>}
                      {rule.id === 'ditinjau' && (
                        <span class="msg__chips"><i class="is-kerangka">Kerangka</i><i class="is-draf">Draf</i><i class="is-ditinjau">Ditinjau praktisi</i></span>
                      )}
                      {rule.id === 'netral' && <span class="msg__disclose">Pengungkapan: halaman ini menyebut mitra Krekit. Kerja sama tidak mengubah penilaian.</span>}
                    </div>
                  </div>
                </>
              ))}
              <div class="msg msg--krekit" data-chat-outro>Itu tiga aturan untuk setiap halaman. Lengkapnya ada di Standar konten.</div>
            </div>
            <div class="chat__replies" data-chat-replies>
              {RULES_QA.map((rule) => <button type="button" data-chat-ask={rule.id}>{rule.question}</button>)}
              <button type="button" data-chat-reset hidden>Ulangi dari awal</button>
            </div>
          </div>
          <div class="krekit-spot krekit-spot--chat" data-krekit-spot aria-hidden="true"></div>
        </figure>
        <div class="section__inner">
          <p class="eyebrow" data-reveal>04 · Prinsip konten</p>
          <h2 class="display display--md" data-reveal>Tiga aturan<br /><span class="accent">untuk setiap halaman.</span></h2>
          <p class="lead" data-reveal>Pertanyaan yang sering muncul saat membaca konten game, dan aturan Krekit yang menjawabnya.</p>
          <ol class="rule-chips" data-reveal>
            {RULES_QA.map((rule, i) => (
              <li data-rule={rule.id}><span>{i + 1}</span>{rule.title}</li>
            ))}
          </ol>
          <div class="actions" data-reveal>
            <a class="btn btn--ghost btn--wire" href={withBase('/kontribusi/standar-konten/')}><span class="btn__label">Baca standar konten</span></a>
          </div>
        </div>
      </section>

      <!--
        05 · Bergabung sebagai layar akhir game: daftar kredit bergulir pelan (CSS, landing.js hanya menyalakannya
        saat terlihat), dengan slot kontributor yang masih kosong. Desktop: tulisan di kiri, kredit di kanan dengan
        Krekit berdiri di atasnya. HP: judul, kredit, lalu ajakan dan tombol.
      -->
      <section id="bergabung" class="section section--end reveal" data-section>
        <div class="end-head">
          <p class="eyebrow" data-reveal>05 · Bergabung</p>
          <h2 class="display display--md" data-reveal>Terima kasih sudah <span class="accent">main sampai akhir.</span></h2>
        </div>
        <div class="credits-stage" data-reveal>
          <div class="krekit-spot krekit-spot--credits" data-krekit-spot aria-hidden="true"></div>
          <div class="credits" data-credits>
            <!-- Hanya satu daftar di HTML; salinan untuk putaran animasi dibuat landing.js (tidak terbaca ganda) -->
            <div class="credits__roll">
              <div class="credits__list">
                <p class="credits__logo">KREKIT</p>
                {CREDITS.map((group) => (
                  <div class="credits__group">
                    <small>{group.role}</small>
                    {group.slot ? (
                      <a class="credits__slot" href={withBase('/kontribusi/')}>Namamu bisa di sini</a>
                    ) : (
                      <>
                        <b>{group.name}</b>
                        {group.note && <span>{group.note}</span>}
                      </>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <!-- Menu penutup di bawah kredit, seperti menu layar akhir game -->
          <div class="credits__menu">
            <ShareButton
              title={`${SITE.name} · Belajar cara game dibuat`}
              text="Pahami fundamental di balik sebuah game: engine dan shader, desain, produksi, sampai bisnis studio indie."
            />
            <button type="button" class="btn btn--ghost btn--wire credits__replay" data-replay><span class="btn__label">Main lagi ↺</span></button>
          </div>
        </div>
        <div class="end-body">
          <p class="lead" data-reveal>Daftar kreditnya masih pendek. Programmer, artist, desainer, produser, dan pelaku bisnis bisa ikut mengisinya: koreksi fakta, tulis artikel, bagikan studi kasus, atau tinjau konten di bidangmu.</p>
          <div class="actions" data-reveal>
            <a class="btn btn--primary btn--wire" href={withBase('/kontribusi/')} data-krekit-say="Koreksi satu kalimat pun sudah membantu."><span class="btn__label">Cara berkontribusi →</span></a>
            <a class="btn btn--ghost btn--wire" href={SITE.repo} data-krekit-say="Semua kodenya terbuka, termasuk kodeku."><span class="btn__label">Repositori GitHub</span></a>
          </div>
          <footer class="site-foot" data-reveal>
            Konten <a href={withBase('/lisensi/')}>CC BY-NC-SA 4.0</a> · Kode MIT · <a href={withBase('/kemitraan/')}>Kemitraan</a> · <a href={withBase('/tentang/')}>Tentang proyek</a>
          </footer>
        </div>
      </section>
    </main>

    <script>
      import '../site/landing.js'
    </script>
    <BottomNav />
  </body>
</html>
